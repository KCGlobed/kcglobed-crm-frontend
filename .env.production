# Production build only (`npm run build`) — overrides .env.
# The deployed nginx serves the built files and has no /api proxy, so the app
# calls the backend directly. The backend allows https://crm.kcglobed.com via
# CORS with credentials, and both hosts are on kcglobed.com, so the refresh
# cookie still flows.
VITE_API_BASE_URL=https://crm-backend.kcglobed.com/api/v1
