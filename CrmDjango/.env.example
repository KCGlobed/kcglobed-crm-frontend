# Server
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# Database — SQLite file path (relative to this folder)
SQLITE_PATH=db.sqlite3

# Auth (same meaning as the Node backend)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Public lead-capture API (website / landing pages / connectors)
CAPTURE_API_KEY=

# Seed bootstrap (used only by `python manage.py seed`)
SEED_ADMIN_EMAIL=admin@gccschool.com
SEED_ADMIN_PASSWORD=

# Mail (optional — reset links are logged when SMTP is not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@gccschool.com
