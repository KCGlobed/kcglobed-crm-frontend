# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas)
MONGO_URI=
DB_NAME=gcc-crm

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Public lead-capture API (website / landing pages / connectors)
CAPTURE_API_KEY=

# Seed bootstrap (used only by `npm run seed`)
SEED_ADMIN_EMAIL=admin@gccschool.com
SEED_ADMIN_PASSWORD=

# Mail (optional — reset links are logged when SMTP is not configured)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@gccschool.com
