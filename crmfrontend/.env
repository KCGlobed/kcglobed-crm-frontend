# CRM backend (Django) server. The Vite dev proxy forwards every /api request here.
# Change it if Django runs on another host or port, e.g. http://localhost:8000
BACKEND_URL=http://192.168.1.34:8002

# Base path of the CRM API. Leave as /api/v1 to use the Vite dev proxy
# (and a same-origin reverse proxy in production).
VITE_API_BASE_URL=/api/v1
