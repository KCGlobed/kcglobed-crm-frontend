# Base path of the CRM API. Keep it as /api/v1 so the browser only talks to this
# dev server and the Vite proxy forwards to the backend — the refresh cookie
# then stays same-site. Don't put a full http://IP:port URL here.
VITE_API_BASE_URL=/api/v1
 
# Backend the dev proxy forwards /api to (restart `npm run dev` after changing).
#   this PC:            http://localhost:4000
#   other PC on the LAN: http://192.168.1.5:8002
API_PROXY_TARGET=https://crm-backend.kcglobed.com
 